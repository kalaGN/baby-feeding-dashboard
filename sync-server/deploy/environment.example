SYNC_ORIGIN=https://babysync.codeainews.top
SYNC_HOST=127.0.0.1
SYNC_PORT=4180
SYNC_DATABASE=/var/lib/baby-feeding-sync/state.sqlite
SYNC_TRUST_PROXY=1
